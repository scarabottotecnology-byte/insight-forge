# Firebase client SDK — valores públicos, seguros no bundle do navegador.
# Pegue em: Firebase Console > Configurações do projeto > Seus apps > SDK setup
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Admin SDK — NUNCA prefixar com VITE_ (não pode ir pro bundle do cliente).
# JSON da service account minificado em uma linha só.
# Gere em: Firebase Console > Configurações do projeto > Contas de serviço > Gerar nova chave privada
FIREBASE_SERVICE_ACCOUNT=

# Asaas (gateway de pagamento) — NUNCA prefixar com VITE_ (chave secreta de servidor).
# Gere/rotacione em: Asaas > Integrações > Chave de API
ASAAS_ENV=
ASAAS_API_KEY=
# Gere uma string aleatória e cadastre o mesmo valor no header "asaas-access-token"
# ao configurar a URL do webhook (/api/webhooks/asaas) no painel Asaas.
ASAAS_WEBHOOK_TOKEN=

# Bucket do Storage que guarda os arquivos dos produtos (V-203). Em geral é o mesmo valor
# de VITE_FIREBASE_STORAGE_BUCKET — existe separado para o servidor não depender de uma
# variável VITE_ (que é pública por definição).
# A service account precisa ter client_email + private_key para assinar os links localmente.
FIREBASE_STORAGE_BUCKET=

# Entrega digital (V-203/V-204) — todas opcionais, os padrões estão entre parênteses.
# Validade do link assinado, em minutos (15).
DOWNLOAD_LINK_TTL_MINUTES=
# Quantos downloads cada produto comprado permite (5).
DOWNLOAD_MAX_PER_ORDER=
# Por quantos dias o acesso ao arquivo continua valendo depois da compra (365).
DOWNLOAD_GRANT_DAYS=
