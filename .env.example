# Firebase client SDK — valores públicos, seguros no bundle do navegador.
# Pegue em: Firebase Console > Configurações do projeto > Seus apps > SDK setup
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Admin SDK — NUNCA prefixar com VITE_ (não pode ir pro bundle do cliente).
# JSON da service account minificado em uma linha só.
# Gere em: Firebase Console > Configurações do projeto > Contas de serviço > Gerar nova chave privada
FIREBASE_SERVICE_ACCOUNT=
