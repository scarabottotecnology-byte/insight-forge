rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Product source files live under /deliverables/{slug}/... and are never served
    // by a public download URL — access is only via short-lived signed URLs minted
    // server-side (Admin SDK) after verifying the buyer owns a paid order (V-203/V-204).
    match /deliverables/{allPaths=**} {
      allow read: if false;
      allow write: if false;
    }

    // Product cover images / mockups shown in the catalog — public read, admin-only write.
    match /catalog/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.role == "admin";
    }
  }
}
